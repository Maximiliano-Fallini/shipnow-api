# Puerto del servidor HTTP
PORT=8080

# Entorno de ejecucion: development | production | test
NODE_ENV=development

# Cadena de conexion a MongoDB (incluye el nombre de la base de datos)
MONGODB_URI=mongodb://localhost:27017/shipnow

# Nivel de logging de Winston: error | warn | info | http | debug
LOG_LEVEL=info

# Carpeta destino de los archivos subidos
UPLOAD_DIR=uploads/documents

# Tamano maximo permitido por archivo, expresado en MB
MAX_FILE_SIZE_MB=80
